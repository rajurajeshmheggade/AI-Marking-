# Copy this file to .env and adjust per environment if needed.
# These are the shared (non-secret) API base URLs the app currently points at.
VITE_AIMARKING_API_BASE=https://sarasenterprise-ai-demo.excelsoftcorp.com/AIMarkingProdAPI/api
VITE_ICMEPRODUCT_API_BASE=https://saras-ai-app.excelsoftcorp.com/AIMarkingProd
VITE_REPO_BASE=https://icmeprod.excelsoftcorp.com/ICME/ICME_Repo
VITE_AIAPPS_API_BASE=https://ailevate-poc.excelsoftcorp.com/aiapps
VITE_AIAPPS_WEB_BASE=https://aiapps.z29.web.core.windows.net
VITE_AI_EXCELSOFT_BASE=https://ai.excelsoftcorp.com

# Video-mode transcription service (not the product's own transcribe-audio).
# Local by default - point this at wherever that service actually runs for
# environments other than your own machine.
VITE_VIDEO_TRANSCRIBE_API_BASE=http://127.0.0.1:8002/v1
# Language hint sent with every Video-mode transcription request (field "language").
# Defaults to "en" in code when unset.
VITE_VIDEO_TRANSCRIBE_LANGUAGE=en
